# Copy these settings into your local environment only as needed.
# This is a local demonstration system, NOT a bank production deployment.
AEGIS_API_URL=http://localhost:8000
AEGIS_OLLAMA_URL=http://localhost:11434
AEGIS_MODEL=qwen3:8b
AEGIS_TIMEOUT=300
AEGIS_DB_PATH=database/aegis.db
# Populate only after you publish/activate the n8n workflow.
# Test URLs (/webhook-test/) are temporary and NOT suitable for dashboard use.
AEGIS_N8N_WEBHOOK_URL=
